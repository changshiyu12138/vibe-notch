<Window x:Class="VibeNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vibe Notch"
        Width="486" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Topmost="True" Focusable="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#7FB0FF" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="Transparent" CornerRadius="8" Padding="9,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#1CFFFFFF" />
                                <Setter Property="Foreground" Value="#F2FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Island"
                Width="196" Height="8"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="0,0,20,20"
                Background="#F5141519"
                BorderBrush="#1FFFFFFF"
                BorderThickness="0,0,1,1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <Grid x:Name="ContentRoot" Margin="16,9,16,13" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="CompactRow" Grid.Row="0" Height="20" Cursor="Hand" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#3DDC84"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse x:Name="PulseRing" Width="16" Height="16" Stroke="#3DDC84"
                                 StrokeThickness="1" Opacity="0" />
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="ProjectText" Text="Qoder" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                        <TextBlock x:Name="ToolText" Text="空闲" FontSize="11" Foreground="#8CFFFFFF"
                                   TextTrimming="CharacterEllipsis" MaxWidth="160" Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Border x:Name="ContextBadge" Background="#14FFFFFF" CornerRadius="8"
                                Padding="6,1" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed">
                            <TextBlock x:Name="ContextValue" Text="ctx 0%" FontSize="10" Foreground="#8CFFFFFF" />
                        </Border>
                        <Border x:Name="CountBadge" Background="#1FFFFFFF" CornerRadius="8"
                                Padding="6,1" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="CountText" Text="1" FontSize="10" Foreground="#B3FFFFFF" />
                        </Border>
                        <Button x:Name="MenuButton" Content="☰" Visibility="Collapsed"
                                Style="{StaticResource MenuIconButton}" Margin="6,0,0,0"
                                ToolTip="设置" Click="MenuToggle_Click" />
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="SessionList" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed" Focusable="False" Opacity="0">
                    <ItemsControl.RenderTransform>
                        <TranslateTransform x:Name="SessionListShift" Y="-6" />
                    </ItemsControl.RenderTransform>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="42" CornerRadius="10" Padding="10,6" Margin="0,1"
                                    Tag="{Binding Id}" Cursor="Hand"
                                    MouseLeftButtonUp="SessionRow_Click"
                                    ToolTip="{Binding RowTooltip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#14FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="7" Height="7" Fill="{Binding AccentBrush}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProjectName}" Foreground="#F2FFFFFF" FontSize="12"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RowSubtitle}" Foreground="#8CFFFFFF" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding TimeAgoText}" Foreground="#5CFFFFFF"
                                               FontSize="10" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="ApprovalPanel" Grid.Row="2" Visibility="Collapsed" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ApprovalShift" Y="-6" />
                    </StackPanel.RenderTransform>
                    <Grid Height="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="ApprovalDot" Width="8" Height="8" Fill="#FFB020" VerticalAlignment="Center" />
                        <TextBlock x:Name="ApprovalTitle" Grid.Column="1" Text="需要你的授权" Foreground="#FFD48A" FontSize="11"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ApprovalTool" Grid.Column="2" Text="Bash" Foreground="#F2FFFFFF"
                                   FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="260" />
                    </Grid>

                    <StackPanel x:Name="QuestionBox" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock x:Name="QuestionText" Foreground="#E6FFFFFF" FontSize="11.5"
                                   TextWrapping="Wrap" LineHeight="16" MaxHeight="48" />
                        <ItemsControl x:Name="QuestionOptions" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="9,5" CornerRadius="8" Background="#14FFFFFF"
                                            Cursor="Hand" Tag="{Binding Label}" ToolTip="{Binding Description}"
                                            MouseLeftButtonUp="QuestionOption_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#24FFFFFF" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="✓" Foreground="#3DDC84" FontSize="11" Width="14"
                                                       Visibility="{Binding Selected, Converter={StaticResource BoolVis}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#F2FFFFFF" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="QuestionHint" Margin="0,5,0,0" FontSize="10" Foreground="#66FFFFFF"
                                   Text="点选项直接作答 · 多选题勾选后点「允许」提交" />
                    </StackPanel>

                    <StackPanel x:Name="ApprovalBox">
                        <Border Background="#12FFFFFF" CornerRadius="9" Padding="10,7" Margin="0,8,0,0"
                                BorderBrush="#14FFFFFF" BorderThickness="1">
                            <ScrollViewer x:Name="ApprovalScroll" MaxHeight="82"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="DiffView" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       TextWrapping="Wrap" LineHeight="15" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBox x:Name="ApprovalEdit" Visibility="Collapsed" AcceptsReturn="True"
                                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                                 Foreground="#F2FFFFFF" Background="#1CFFFFFF" BorderBrush="#33FFFFFF"
                                 BorderThickness="1" CaretBrush="#FFFFFF" Padding="8,5" Margin="0,8,0,0"
                                 Height="96" VerticalScrollBarVisibility="Auto"
                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseDown"
                                 LostFocus="ApprovalEdit_LostFocus" />

                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Button x:Name="AlwaysAllowButton" Content="总是允许" Style="{StaticResource LinkButton}"
                                    Click="AlwaysAllow_Click" />
                            <Button x:Name="EditButton" Content="编辑后允许" Style="{StaticResource LinkButton}"
                                    Margin="12,0,0,0" Click="EditToggle_Click" />
                        </StackPanel>

                        <TextBox x:Name="DenyReason" Margin="0,6,0,0" Height="26" FontSize="11"
                                 Foreground="#E6FFFFFF" Background="#12FFFFFF" BorderBrush="#1FFFFFFF"
                                 BorderThickness="1" CaretBrush="#FFFFFF" Padding="8,4"
                                 VerticalContentAlignment="Center" GotFocus="DenyReason_GotFocus"
                                 PreviewMouseLeftButtonDown="TextBox_PreviewMouseDown"
                                 LostFocus="DenyReason_LostFocus" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="DenyButton" Content="拒绝" Style="{StaticResource PillButton}"
                                Background="#1CFFFFFF" Foreground="#E6FFFFFF" BorderBrush="#26FFFFFF"
                                Click="Deny_Click" />
                        <Button x:Name="AllowButton" Grid.Column="2" Content="允许" Style="{StaticResource PillButton}"
                                Background="#3DDC84" Foreground="#06210F" BorderBrush="#3DDC84"
                                Click="Allow_Click" />
                    </Grid>

                    <TextBlock x:Name="ApprovalQueue" Margin="0,8,0,0" FontSize="10" Foreground="#66FFFFFF"
                               Height="14" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid x:Name="Footer" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="FooterShift" Y="-6" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FooterHint" FontSize="10" Foreground="#59FFFFFF" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="点击会话聚焦 Qoder · 右键托盘更多设置" />
                    <Button x:Name="InterruptButton" Grid.Column="1" Content="中断" Style="{StaticResource MiniButton}"
                            Click="Interrupt_Click" ToolTip="向 Qoder 发送 Esc（不抢焦点）" />
                    <Button x:Name="ContinueButton" Grid.Column="3" Content="继续" Style="{StaticResource MiniButton}"
                            Click="Continue_Click" ToolTip="向 Qoder 输入「继续」并回车（不抢焦点）" />
                    <TextBlock x:Name="TodayStats" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,5,0,0"
                               FontSize="9.5" Foreground="#4DFFFFFF" TextTrimming="CharacterEllipsis"
                               Text="今天还没有活动" />
                </Grid>

                <StackPanel x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="3" Margin="0,8,0,0"
                            Visibility="Collapsed" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="SettingsShift" Y="-6" />
                    </StackPanel.RenderTransform>

                    <Button Style="{StaticResource MenuRow}" Tag="back" Click="SettingsRow_Click">
                        <Grid>
                            <TextBlock Text="‹  返回" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Height="1" Background="#14FFFFFF" Margin="4,5" />

                    <Button Style="{StaticResource MenuRow}" Tag="position" Click="SettingsRow_Click"
                            ToolTip="点击切换：固定屏幕 / 跟随鼠标 / 跟随 Qoder">
                        <Grid>
                            <TextBlock Text="浮岛位置" VerticalAlignment="Center" />
                            <TextBlock x:Name="PositionValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="10.5" Foreground="#8CFFFFFF" Text="固定屏幕" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuRow}" Tag="screen" Click="SettingsRow_Click"
                            ToolTip="点击选择浮岛固定的显示器">
                        <Grid>
                            <TextBlock Text="显示器" VerticalAlignment="Center" />
                            <TextBlock x:Name="ScreenValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="10.5" Foreground="#8CFFFFFF" Text="显示器 1"
                                       MaxWidth="240" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>

                    <StackPanel x:Name="ScreenList" Visibility="Collapsed" />

                    <Button Style="{StaticResource MenuRow}" Tag="sound" Click="SettingsRow_Click">
                        <Grid>
                            <TextBlock Text="提示音" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="SoundDot" Width="6" Height="6" Fill="#3DDC84" VerticalAlignment="Center" />
                                <TextBlock x:Name="SoundValue" Text="开" FontSize="10.5" Foreground="#8CFFFFFF" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuRow}" Tag="tone" Click="SettingsRow_Click"
                            ToolTip="点击切换内置提示音，切换后立即试听">
                        <Grid>
                            <TextBlock Text="提示音音效" VerticalAlignment="Center" />
                            <TextBlock x:Name="ToneValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="10.5" Foreground="#8CFFFFFF" Text="清铃" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuRow}" Tag="notify" Click="SettingsRow_Click">
                        <Grid>
                            <TextBlock Text="系统通知" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="NotifyDot" Width="6" Height="6" Fill="#3DDC84" VerticalAlignment="Center" />
                                <TextBlock x:Name="NotifyValue" Text="开" FontSize="10.5" Foreground="#8CFFFFFF" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuRow}" Tag="autostart" Click="SettingsRow_Click">
                        <Grid>
                            <TextBlock Text="开机自启" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="AutoStartDot" Width="6" Height="6" Fill="#3DDC84" VerticalAlignment="Center" />
                                <TextBlock x:Name="AutoStartValue" Text="开" FontSize="10.5" Foreground="#8CFFFFFF" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuRow}" Tag="hooks" Click="SettingsRow_Click"
                            ToolTip="点击安装 / 移除写入 Qoder 的 Hook">
                        <Grid>
                            <TextBlock Text="Hooks" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="HooksDot" Width="6" Height="6" Fill="#3DDC84" VerticalAlignment="Center" />
                                <TextBlock x:Name="HooksValue" Text="已安装" FontSize="10.5" Foreground="#8CFFFFFF" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuRow}" Tag="test" Click="SettingsRow_Click">
                        <Grid>
                            <TextBlock Text="测试通知" VerticalAlignment="Center" />
                            <TextBlock Text="点击发送" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="10.5" Foreground="#5CFFFFFF" />
                        </Grid>
                    </Button>

                    <Border Height="1" Background="#14FFFFFF" Margin="4,5" />

                    <TextBlock x:Name="AboutText" Text="Vibe Notch" FontSize="10" Foreground="#59FFFFFF"
                               Margin="13,0,0,0" Height="18" VerticalAlignment="Center" />

                    <Button Style="{StaticResource MenuRow}" Tag="quit" Click="SettingsRow_Click">
                        <TextBlock Text="退出 Vibe Notch" Foreground="#FF6666" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
